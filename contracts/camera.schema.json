{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CameraPlacement",
  "description": "Placement + calibration data layered on the existing camera registration (backend/app/cctv).",
  "type": "object",
  "required": ["camera_id", "venue_id", "floor_id", "position_m", "calibration_status"],
  "properties": {
    "camera_id": {"type": "string"},
    "venue_id": {"type": "string"},
    "floor_id": {"type": "string"},
    "position_m": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "heading_deg": {"type": "number", "description": "0 = +x axis, clockwise positive in map space"},
    "coverage_polygon_m": {"type": "array", "items": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}},
    "zone_ids": {"type": "array", "items": {"type": "string"}},
    "calibration_status": {"enum": ["none", "needs_recalibration", "calibrated"]},
    "calibration": {
      "type": "object",
      "properties": {
        "version": {"type": "integer"},
        "map_version": {"type": "integer"},
        "homography": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}},
        "reprojection_error_m": {"type": "number"},
        "point_pairs": {"type": "array", "items": {"type": "object", "required": ["u", "v", "x", "y"], "properties": {"u": {"type": "number"}, "v": {"type": "number"}, "x": {"type": "number"}, "y": {"type": "number"}, "held_out": {"type": "boolean"}}}}
      }
    }
  }
}
